{
  "name": "@bitkyc08/opencodex",
  "version": "2.99.0",
  "private": true,
  "description": "Personal Windows-only OpenCodex Lite gateway",
  "type": "module",
  "main": "./backend/bin/package-main.mjs",
  "exports": {
    ".": {
      "bun": "./backend/src/index.ts",
      "default": "./backend/bin/package-main.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opencodex": "./backend/bin/ocx.mjs",
    "ocx": "./backend/bin/ocx.mjs"
  },
  "files": [
    "backend/bin",
    "backend/src",
    "frontend/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "trustedDependencies": [
    "bun"
  ],
  "testRunnerBun": "1.4.4",
  "scripts": {
    "dev": "bun run backend/src/cli/index.ts start",
    "dev:proxy": "bun run backend/src/cli/index.ts start",
    "dev:gui": "cd frontend && bun run dev",
    "start": "bun run backend/src/cli/index.ts start",
    "test": "bun scripts/test.ts",
    "test:changed": "bun scripts/test.ts --changed=dev",
    "typecheck": "bun check --no-script --noEmit --project backend/tsconfig.json",
    "typecheck:tsc": "bun x tsc --noEmit --project backend/tsconfig.json",
    "typecheck:gui:if-changed": "bun scripts/typecheck-gui-if-changed.ts",
    "audit:high": "bun audit --audit-level=high && cd frontend && bun audit --audit-level=high",
    "privacy:scan": "bun scripts/privacy-scan.ts",
    "favicons": "bun scripts/brand-favicons.ts",
    "favicons:check": "bun scripts/brand-favicons.ts --check",
    "generate:model-metadata": "bun scripts/generate-model-metadata.ts",
    "build:gui": "cd frontend && bun run build",
    "build:standalone": "bun scripts/build-standalone.ts",
    "lint:gui": "cd frontend && bun run lint",
    "lint:gui:if-changed": "bun scripts/lint-gui-if-changed.ts",
    "doctor:gui": "cd frontend && bun run doctor",
    "doctor:gui:full": "cd frontend && bun run doctor:full",
    "doctor:gui:if-changed": "bun scripts/doctor-gui-if-changed.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "1.3.0",
    "bun": "1.4.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "wreq-js": "2.3.1"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "body-parser": "2.4.0",
    "fast-uri": "^3.1.7",
    "hono": "4.13.13",
    "ip-address": "^10.7.4",
    "qs": "^6.16.1"
  },
  "keywords": [
    "codex",
    "openai",
    "proxy",
    "llm",
    "ollama",
    "anthropic",
    "responses-api",
    "claude-code",
    "claude",
    "codex-cli",
    "gemini",
    "grok",
    "deepseek",
    "chatgpt",
    "llm-proxy",
    "ai-gateway",
    "openrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidge-jun/opencodex.git"
  },
  "homepage": "https://lidge-jun.github.io/opencodex/",
  "bugs": {
    "url": "https://github.com/lidge-jun/opencodex/issues"
  },
  "license": "MIT"
}
