{
  "name": "gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --config vite.runtime.config.ts",
    "dev:runtime": "node node_modules/vite/bin/vite.js --config vite.runtime.config.ts",
    "build:runtime": "tsc -b && node node_modules/vite/bin/vite.js build --config vite.runtime.config.ts",
    "build": "tsc -b && node node_modules/vite/bin/vite.js build --config vite.runtime.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:i18n": "eslint src/pages src/components src/App.tsx src/main.tsx src/ui.tsx src/features",
    "doctor": "npx --yes react-doctor@0.9.11 --verbose --scope changed --base origin/main --no-telemetry",
    "doctor:full": "npx --yes react-doctor@0.9.11 --verbose --scope full --no-telemetry",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src .eslint *.ts *.json *.mjs *.html .prettierrc.json",
    "format:check": "prettier --check src .eslint *.ts *.json *.mjs *.html .prettierrc.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "wanted-sans": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/estree-jsx": "1.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
